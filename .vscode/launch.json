{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Postgres",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose up",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Back",
      "type": "node-terminal",
      "request": "launch",
      "command": "until docker compose -f ../docker-compose.yml exec -T postgres pg_isready -U poc -d poc_gestao; do sleep 1; done && .venv/bin/python manage.py migrate && .venv/bin/python manage.py runserver 127.0.0.1:8000",
      "cwd": "${workspaceFolder}/back"
    },
    {
      "name": "Front",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --port 3000",
      "cwd": "${workspaceFolder}/front"
    }
  ],
  "compounds": [
    {
      "name": "Start",
      "configurations": ["Postgres", "Back", "Front"],
      "stopAll": true
    }
  ]
}
